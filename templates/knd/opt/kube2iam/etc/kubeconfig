apiVersion: v1
kind: Config
clusters:
- name: localhost
  cluster:
    server: https://localhost:6443
    certificate-authority: /opt/crt/ca.crt
users:
- name: kube2iam
  user:
    client-certificate: /opt/crt/kube2iam.client.crt
    client-key: /opt/key/kube2iam/kube2iam.client.key
contexts:
- name: kube2iam
  context:
    cluster: localhost
    user: kube2iam
current-context: kube2iam

apiVersion: v1
kind: Config
clusters:
- name: localhost
  cluster:
    server: https://localhost:6443
    certificate-authority: /opt/crt/ca.crt
users:
- name: kubelet
  user:
    client-certificate: /opt/crt/kubelet.client.crt
    client-key: /opt/key/kubelet/kubelet.client.key
contexts:
- name: kubelet
  context:
    cluster: localhost
    user: kubelet
current-context: kubelet

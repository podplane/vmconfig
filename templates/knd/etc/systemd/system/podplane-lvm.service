[Unit]
Description=Prepare Podplane local data volume group
ConditionPathExists=/dev/disk/by-id/virtio-podplane-data
Before=kubelet.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/podplane/bin/prepare-lvm.sh

[Install]
WantedBy=multi-user.target

[Unit]
Description=containerd container runtime
After=network.target local-fs.target dbus.service
[Service]
Environment=CONTAINERD_CONFIG=/etc/containerd/config.toml
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/containerd --config ${CONTAINERD_CONFIG}
Type=notify
Delegate=yes
KillMode=process
Restart=always
RestartSec=5
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
OOMScoreAdjust=-999
[Install]
WantedBy=multi-user.target

[Unit]
Description=Configure Podplane NAT forwarding
Wants=network-online.target
After=network-online.target systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/podplane/bin/nat-host.sh activate
ExecStop=/opt/podplane/bin/nat-host.sh deactivate
RuntimeDirectory=podplane
RuntimeDirectoryMode=0755
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_MODULE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
ReadWritePaths=/run/podplane
RestrictAddressFamilies=AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

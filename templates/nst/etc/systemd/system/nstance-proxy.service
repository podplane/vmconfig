[Unit]
Description=Nstance sleep proxy
After=network-online.target nstance-server.service
Wants=network-online.target
Requires=nstance-server.service

[Service]
Type=exec
User=nstance-proxy
Group=nstance-proxy
EnvironmentFile=/opt/env/nstance-server-proxy.env
ExecStart=/opt/nstance-server/bin/nstance-server proxy \
    --socket=${NSTANCE_PROXY_SOCKET} \
    --bind-host=${NSTANCE_PROXY_BIND_HOST}
Restart=always
RestartSec=5s
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target

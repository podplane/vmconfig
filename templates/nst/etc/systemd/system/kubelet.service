[Unit]
Description=Standalone kubelet for Nstance tunnel static Pods
After=containerd.service nstance-tunnel.service
Requires=containerd.service
BindsTo=nstance-tunnel.service
PartOf=nstance-tunnel.service

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/bin/kubelet \
    --config=/opt/kubelet/etc/kubelet.yaml \
    --container-runtime-endpoint=unix:///run/containerd/containerd.sock \
    --register-node=false
Restart=always
RestartSec=10s
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target

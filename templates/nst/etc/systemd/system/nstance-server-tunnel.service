[Unit]
Description=Nstance tunnel supervisor
After=network-online.target nstance-server.service containerd.service kubelet.service
Wants=network-online.target nstance-server.service
Requires=containerd.service kubelet.service

[Service]
Type=exec
User=root
Group=root
EnvironmentFile=/opt/env/nstance-server-tunnel.env
ExecStart=/opt/nstance-server/bin/nstance-server tunnel \
    --storage=${NSTANCE_TUNNEL_STORAGE} \
    --bucket=${NSTANCE_TUNNEL_BUCKET} \
    --shard=${NSTANCE_TUNNEL_SHARD} \
    --prefix=${NSTANCE_TUNNEL_PREFIX} \
    --server-socket=${NSTANCE_TUNNEL_SOCKET} \
    --manifest-dir=${NSTANCE_TUNNEL_MANIFEST_DIR} \
    --files-dir=${NSTANCE_TUNNEL_FILES_DIR}
Restart=always
RestartSec=5s
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/etc/kubernetes/manifests /opt/podplane/tunnel/files /run/nstance/tunnel
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target

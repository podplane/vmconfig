apiVersion: v1
kind: Config
clusters:
- name: localhost
  cluster:
    server: https://localhost:6443
    certificate-authority: /opt/crt/ca.crt
users:
- name: kube-controller-manager
  user:
    client-certificate: /opt/crt/kube-controller-manager.client.crt
    client-key: /opt/key/kube-controller-manager/kube-controller-manager.client.key
contexts:
- name: kube-controller-manager
  context:
    cluster: localhost
    user: kube-controller-manager
current-context: kube-controller-manager

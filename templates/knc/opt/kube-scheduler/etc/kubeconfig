apiVersion: v1
kind: Config
clusters:
- name: localhost
  cluster:
    server: https://localhost:6443
    certificate-authority: /opt/crt/ca.crt
users:
- name: kube-scheduler
  user:
    client-certificate: /opt/crt/kube-scheduler.client.crt
    client-key: /opt/key/kube-scheduler/kube-scheduler.client.key
contexts:
- name: kube-scheduler
  context:
    cluster: localhost
    user: kube-scheduler
current-context: kube-scheduler
